Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Agx", " ", "Config"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kAgXMinEV", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{"-", "10.0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kAgXMaxEV", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{"+", "6.5"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kAgXXPivot", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"kAgXMinEV", "/", 
       RowBox[{"(", 
        RowBox[{"kAgXMaxEV", "-", "kAgXMinEV"}], ")"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"kAgXYPivot", "=", 
     RowBox[{"Rationalize", "[", "0.50", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kLimitsContrast1", "=", 
     RowBox[{"Rationalize", "[", "3.0", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kLimitsContrast2", "=", 
     RowBox[{"Rationalize", "[", "3.25", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kGeneralContrast", "=", 
     RowBox[{"Rationalize", "[", "2.0", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", "AgX", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"equationScale", "[", 
      RowBox[{"xPivot_", ",", "yPivot_", ",", "slopePivot_", ",", "power_"}], 
      "]"}], ":=", 
     RowBox[{
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"slopePivot", "*", "xPivot"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"-", "power"}], ")"}]}], ")"}], " ", "*", 
        "\[IndentingNewLine]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"slopePivot", " ", "*", 
             RowBox[{"xPivot", "/", "yPivot"}]}], ")"}], "^", 
           RowBox[{"(", "power", ")"}]}], "-", "1"}], ")"}]}], 
       "\[IndentingNewLine]", ")"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "power"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"equationHyperbolic", "[", 
      RowBox[{"x_", ",", "power_"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"x", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"x", "^", "power"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "power"}], ")"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"equationTerm", "[", 
      RowBox[{"x_", ",", "xPivot_", ",", "slopePivot_", ",", "scale_"}], 
      "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"slopePivot", "*", 
        RowBox[{"(", 
         RowBox[{"x", "-", "xPivot"}], ")"}]}], ")"}], "/", "scale"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"equationCurve", "[", 
      RowBox[{
      "x_", ",", "xPivot_", ",", "yPivot_", ",", " ", "slopePivot_", ",", 
       "scale_"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"scale", "<", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"scale", "*", 
         RowBox[{"equationHyperbolic", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"equationTerm", "[", 
            RowBox[{"x", ",", "xPivot", ",", "slopePivot", ",", "scale"}], 
            "]"}], ",", "\[IndentingNewLine]", "kLimitsContrast1"}], 
          "\[IndentingNewLine]", "]"}]}], "+", "yPivot"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"scale", "*", 
         RowBox[{"equationHyperbolic", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"equationTerm", "[", 
            RowBox[{"x", ",", "xPivot", ",", "slopePivot", ",", "scale"}], 
            "]"}], ",", "\[IndentingNewLine]", "kLimitsContrast2"}], 
          "\[IndentingNewLine]", "]"}]}], "+", "yPivot"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"equationFullCurve", "[", 
      RowBox[{"x_", ",", "xPivot_", ",", "yPivot_", ",", " ", "slopePivot_"}],
       "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "scaleXPivot", ",", "scaleYPivot", ",", "toeScale", ",", 
         "shoulderScale", ",", "scale"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"scaleXPivot", ":=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"x", ">=", "xPivot"}], ",", 
           RowBox[{"1", "-", "xPivot"}], ",", "xPivot"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"scaleYPivot", ":=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"x", ">=", "xPivot"}], ",", 
           RowBox[{"1", "-", "yPivot"}], ",", "yPivot"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"toeScale", ":=", 
         RowBox[{"equationScale", "[", 
          RowBox[{
          "scaleXPivot", ",", "scaleYPivot", ",", "slopePivot", ",", 
           "kLimitsContrast1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"shoulderScale", ":=", 
         RowBox[{"equationScale", "[", 
          RowBox[{
          "scaleXPivot", ",", "scaleYPivot", ",", "slopePivot", ",", 
           "kLimitsContrast2"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"scale", ":=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"x", ">=", "xPivot"}], ",", "shoulderScale", ",", 
           RowBox[{"-", "toeScale"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"equationCurve", "[", 
         RowBox[{
         "x", ",", "xPivot", ",", "yPivot", ",", "slopePivot", ",", "scale"}],
          "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "OpenColorIO", " ", "allocation", " ", "for", " ", 
     "log2", " ", "from", " ", "open", " ", "domain", " ", "tristimulus", " ",
      "value"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"calculateOCIOLog2", "[", 
      RowBox[{"inEV_", ",", "odMiddleGrey_"}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Log2", "[", 
      RowBox[{
       RowBox[{"2", "^", "inEV"}], "*", "odMiddleGrey"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Debug", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"equationFullCurve", "[", 
      RowBox[{
      "x", ",", "kAgXXPivot", ",", "kAgXYPivot", ",", " ", 
       "kGeneralContrast"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Assuming", " ", "for", " ", "faster", " ", "Simplify"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"x", ">=", 
      RowBox[{"20", "/", "33"}]}], ",", 
     RowBox[{"Simplify", "[", 
      RowBox[{"equationFullCurve", "[", 
       RowBox[{
       "x", ",", "kAgXXPivot", ",", "kAgXYPivot", ",", " ", 
        "kGeneralContrast"}], "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"x", "<", 
      RowBox[{"20", "/", "33"}]}], ",", 
     RowBox[{"Simplify", "[", 
      RowBox[{"equationFullCurve", "[", 
       RowBox[{
       "x", ",", "kAgXXPivot", ",", "kAgXYPivot", ",", " ", 
        "kGeneralContrast"}], "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"x", ">=", 
      RowBox[{"20", "/", "33"}]}], ",", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"equationFullCurve", "[", 
         RowBox[{
         "x", ",", "kAgXXPivot", ",", "kAgXYPivot", ",", " ", 
          "kGeneralContrast"}], "]"}], "]"}], ",", "MachinePrecision"}], 
      "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"x", "<", 
      RowBox[{"20", "/", "33"}]}], ",", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"equationFullCurve", "[", 
         RowBox[{
         "x", ",", "kAgXXPivot", ",", "kAgXYPivot", ",", " ", 
          "kGeneralContrast"}], "]"}], "]"}], ",", "MachinePrecision"}], 
      "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"N", "[", 
    RowBox[{"calculateOCIOLog2", "[", 
     RowBox[{"kAgXMinEV", ",", 
      RowBox[{"Rationalize", "[", "0.18", "]"}]}], "]"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"N", "[", 
    RowBox[{"calculateOCIOLog2", "[", 
     RowBox[{"kAgXMaxEV", ",", 
      RowBox[{"Rationalize", "[", "0.18", "]"}]}], "]"}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
